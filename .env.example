DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_ID=1

# ============================================================
# Database — gunakan 1 URL (standar industri, mendukung Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Untuk Supabase: gunakan connection pooling URL dari dashboard
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/finder_db

# Docker PostgreSQL (hanya dipakai jika tidak menggunakan DATABASE_URL)
POSTGRES_DB=finder_db
POSTGRES_USER=finder_user
POSTGRES_PASSWORD=finder_password
POSTGRES_PORT=5432

# ============================================================
# Google OAuth (dapatkan dari Google Cloud Console)
# ============================================================
GOOGLE_WORKSPACE_DOMAIN=umkt.ac.id
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=your-client-id.apps.googleusercontent.com

# ============================================================
# Supabase (opsional, untuk integrasi Supabase langsung)
# ============================================================
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# ============================================================
# Localization
# ============================================================
LANGUAGE_CODE=id-id
TIME_ZONE=Asia/Jakarta

# ============================================================
# Security (aktifkan di production)
# ============================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
